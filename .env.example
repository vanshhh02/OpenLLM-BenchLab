# OpenLLM BenchLab Environment Configuration

# Service Ports
PORT=8000
FRONTEND_PORT=5173
MLFLOW_PORT=5000

# Database Configuration (SQLite by default; PostgreSQL for production)
DATABASE_URL=sqlite:///./benchlab.db
# DATABASE_URL=postgresql://benchlab_user:benchlab_password@localhost:5432/benchlab_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Authentication & Workspace Security (Phase 8)
# Set BENCHLAB_AUTH_REQUIRED=true in multi-user production environments
BENCHLAB_AUTH_REQUIRED=false
BENCHLAB_SECRET_KEY=change-me-to-a-long-random-secret
BENCHLAB_ACCESS_TOKEN_MINUTES=60
BENCHLAB_REFRESH_TOKEN_DAYS=7

# Async Job Queue & Workers (Phase 8)
# Options: auto, local, celery
JOB_BACKEND=auto
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# MLflow Tracking URI
MLFLOW_TRACKING_URI=sqlite:///./mlruns.db

# Frontier Commercial LLM APIs (Optional: disable or leave empty for 100% local operation)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Local Hardware & Engine Configuration
# Options: auto, mps, cuda, cpu
BENCHLAB_DEVICE=auto
# Options: native_torch, vllm, llama_cpp
DEFAULT_INFERENCE_ENGINE=native_torch

# Storage Paths
ARTIFACTS_DIR=artifacts
CHECKPOINTS_DIR=artifacts/checkpoints
QUANTIZED_DIR=artifacts/quantized
DATASETS_CACHE_DIR=ml/datasets/cache

